<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain-HTTP ("cleartext") traffic by default. The robot only
  speaks HTTP, so we explicitly allow it for the robot's default address.
  (Flutter's networking uses raw sockets and is not affected by this file, but
  declaring it keeps the app correct if you ever add native HTTP code.)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
    </domain-config>
</network-security-config>
